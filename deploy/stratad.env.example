# stratad.env — every stratad setting with its default (PLAN §14 "Config"; docs/RUNBOOK.md).
#
# Install as /etc/strata/stratad.env (owner root:strata, mode 0640: it holds database
# passwords) and start stratad with `--env-file /etc/strata/stratad.env` (or the variable
# STRATA_ENV_FILE); without either, stratad reads `.env` from its working directory if one
# exists. A variable set in the real environment wins over this file.
#
# Naming: STRATA_ + the setting's path with `__` between the parts, upper-case.
# Syntax (dotenvy): NAME=value, one per line; `#` starts a comment. Put a value that contains
# spaces, `#`, `$` or quotes in single quotes: NAME='value' (inside double quotes or unquoted,
# `$NAME` is expanded). An empty value unsets an optional setting.
#
# The active lines below are the ones a deployment normally sets (shown with their defaults);
# the commented lines document the rest with their defaults (or an example, for settings that
# are unset by default). Unknown names in this file stop stratad from starting.
# `stratad --env-file <file> check-config` validates a file and prints the effective settings.

# ── Server ──────────────────────────────────────────────────────────────────────────────────
# Root of per-user data (users/<id>/vault); must exist, owned by the service user, mode 0700.
STRATA_DATA_ROOT=/srv/strata
# Address the API listens on (nginx proxies to it).
STRATA_BIND=127.0.0.1:8080
# IANA timezone for users who have not set one (task month headings, reminders, digests,
# display). Times are always stored and written in UTC.
# STRATA_DEFAULT_TIMEZONE=UTC
# Seconds a device's creation time on a create may be ahead of the server's clock before the
# create is refused with 422 created_in_future (a wrong device clock).
# STRATA_MAX_FUTURE_SKEW_SECS=300

# ── Database (PostgreSQL; one URL per role, PLAN §5.2) ─────────────────────────────────────
# Passwords go in the URL (percent-encode special characters, and single-quote the value).
# Migrations only:
STRATA_DATABASE__OWNER_URL=postgres://strata_owner@localhost/strata
# Requests and jobs (RLS-scoped):
STRATA_DATABASE__APP_URL=postgres://strata_app@localhost/strata
# Login, sign-up, admin:
STRATA_DATABASE__ACCOUNTS_URL=postgres://strata_accounts@localhost/strata
# Connections per pool (the VPS has one core; keep it small).
# STRATA_DATABASE__MAX_CONNECTIONS=5

# ── AI provider (D20, D23) ─────────────────────────────────────────────────────────────────
# Provider for users without an override: claude_cli (claude -p, L18), anthropic_api
# (Messages API with a server key) or disabled. D23: claude -p serves every account.
# STRATA_AI__DEFAULT_PROVIDER=claude_cli
# Per-user overrides, username=provider pairs separated by commas (usernames as stored).
# STRATA_AI__USER_PROVIDERS=guest=anthropic_api,kid=disabled
# AI jobs per day across all users (0 = unlimited).
# STRATA_AI__DAILY_JOB_LIMIT=0

# ── claude -p (docs/RUNBOOK.md §9) ─────────────────────────────────────────────────────────
# Launcher and its arguments, separated by spaces; the claude arguments are appended.
# Production: 'sudo -n -u strata-ai /usr/local/lib/strata/claude-ai'
# STRATA_AI__CLAUDE_CLI__COMMAND=/usr/local/bin/claude
# Empty working directory of the claude process (owned by strata-ai).
# STRATA_AI__CLAUDE_CLI__SCRATCH_DIR=/var/lib/strata-ai/scratch
# Directory stratad starts COMMAND in; unset = SCRATCH_DIR. Production: / — the scratch
# directory is strata-ai's (0700), so stratad cannot start there; the wrapper changes into it.
# STRATA_AI__CLAUDE_CLI__LAUNCH_DIR=/
# --model passed to claude (alias or full name); unset lets the CLI choose.
# STRATA_AI__CLAUDE_CLI__MODEL=opus
# Concurrent claude processes (§9.1: low).
# STRATA_AI__CLAUDE_CLI__MAX_CONCURRENCY=1
# Wall-clock limit per call, seconds.
# STRATA_AI__CLAUDE_CLI__TIMEOUT_SECS=300
# Seconds between SIGTERM and SIGKILL of a timed-out or cancelled call.
# STRATA_AI__CLAUDE_CLI__KILL_GRACE_SECS=5
# Pause after a usage limit without a reported reset time, seconds.
# STRATA_AI__CLAUDE_CLI__USAGE_LIMIT_PAUSE_SECS=1800

# ── Anthropic Messages API (docs/RUNBOOK.md §11) ───────────────────────────────────────────
# API key file (owner strata, mode 0600; never logged). Required when any user is routed to
# anthropic_api.
# STRATA_AI__ANTHROPIC_API__API_KEY_FILE=/etc/strata/anthropic.key
# STRATA_AI__ANTHROPIC_API__MODEL=claude-opus-5-5
# STRATA_AI__ANTHROPIC_API__BASE_URL=https://api.anthropic.com
# output_config.effort: low, medium, high, xhigh or max; unset = the model's default.
# STRATA_AI__ANTHROPIC_API__EFFORT=high
# Retries after the first attempt on 408/409/429/5xx/529 (honouring retry-after).
# STRATA_AI__ANTHROPIC_API__MAX_RETRIES=3
# Per-request timeout, seconds (whole response, including a stream).
# STRATA_AI__ANTHROPIC_API__TIMEOUT_SECS=600
# Prices of the model in micro-USD per million tokens, for cost caps (Claude Opus 5.5: $4 / $20).
# STRATA_AI__ANTHROPIC_API__INPUT_MICROS_PER_MTOK=4000000
# STRATA_AI__ANTHROPIC_API__OUTPUT_MICROS_PER_MTOK=20000000

# ── Embeddings (in-process ONNX, L19, D9; docs/RUNBOOK.md §10) ─────────────────────────────
# Off (one log line at startup) until both paths are set and exist:
# STRATA_AI__EMBEDDING__MODEL_DIR=/opt/models/granite-embedding-97m-multilingual-r2
# STRATA_AI__EMBEDDING__ONNXRUNTIME_LIB=/opt/onnxruntime/lib/libonnxruntime.so.1.30.0
# Relative to the model directory. Full-precision (fp32) export (owner decision 2026-09-27,
# PLAN §9.1b); the int8 file is onnx/model_quint8_avx2.onnx (then use its own model ID and
# set PAD_BATCHES below to false).
# STRATA_AI__EMBEDDING__MODEL_FILE=onnx/model.onnx
# STRATA_AI__EMBEDDING__TOKENIZER_FILE=tokenizer.json
# Stored with every vector; changing it triggers a full re-embed.
# STRATA_AI__EMBEDDING__MODEL_ID=ibm-granite/granite-embedding-97m-multilingual-r2@onnx/model
# STRATA_AI__EMBEDDING__DIMS=384
# cls (granite-embedding r2) or mean.
# STRATA_AI__EMBEDDING__POOLING=cls
# Tokens per text (longer texts are truncated) and padded tokens per batch.
# STRATA_AI__EMBEDDING__MAX_TOKENS=2048
# STRATA_AI__EMBEDDING__MAX_BATCH_TOKENS=8192
# Whether texts of different lengths share a padded batch (the fp32 export is
# padding-invariant; off for the quint8 export).
# STRATA_AI__EMBEDDING__PAD_BATCHES=true
# Nice value of the embedding thread (0–19).
# STRATA_AI__EMBEDDING__NICE=19
# Seconds without an embedding call after which the model is unloaded (frees ≈ 390 MB); the
# next call loads it again (a second or two).
# STRATA_AI__EMBEDDING__IDLE_UNLOAD_SECS=300

# ── Thresholds ─────────────────────────────────────────────────────────────────────────────
# AI relations at or above this confidence are applied automatically (§9.4).
# STRATA_THRESHOLDS__RELATION=0.7
# Custody events at or above this confidence are applied automatically (§6.12).
# STRATA_THRESHOLDS__CUSTODY=0.85
# Duplicate detection per item kind (§9.7): trigram NEAR similarity, and the embedding
# SEMANTIC similarity at or above which an item is a candidate (borderline scores are
# confirmed by one LLM call). The defaults are the calibrated values of `domain`; aliases
# have no semantic level by default (the value shown is an example).
# STRATA_THRESHOLDS__DEDUPE__ALIAS__NEAR=0.6
# STRATA_THRESHOLDS__DEDUPE__ALIAS__SEMANTIC=0.9
# STRATA_THRESHOLDS__DEDUPE__CAPTURE__NEAR=0.6
# STRATA_THRESHOLDS__DEDUPE__CAPTURE__SEMANTIC=0.9
# STRATA_THRESHOLDS__DEDUPE__COMPANY__NEAR=0.5
# STRATA_THRESHOLDS__DEDUPE__COMPANY__SEMANTIC=0.9
# STRATA_THRESHOLDS__DEDUPE__CONCEPT__NEAR=0.5
# STRATA_THRESHOLDS__DEDUPE__CONCEPT__SEMANTIC=0.88
# STRATA_THRESHOLDS__DEDUPE__DOCUMENT__NEAR=0.8
# STRATA_THRESHOLDS__DEDUPE__DOCUMENT__SEMANTIC=0.92
# STRATA_THRESHOLDS__DEDUPE__NOTE__NEAR=0.6
# STRATA_THRESHOLDS__DEDUPE__NOTE__SEMANTIC=0.9
# STRATA_THRESHOLDS__DEDUPE__PERSON__NEAR=0.5
# STRATA_THRESHOLDS__DEDUPE__PERSON__SEMANTIC=0.9
# STRATA_THRESHOLDS__DEDUPE__PLACE__NEAR=0.8
# STRATA_THRESHOLDS__DEDUPE__PLACE__SEMANTIC=0.92
# STRATA_THRESHOLDS__DEDUPE__TASK__NEAR=0.6
# STRATA_THRESHOLDS__DEDUPE__TASK__SEMANTIC=0.88

# ── AI budgets ─────────────────────────────────────────────────────────────────────────────
# Daily caps; 0 = unlimited. A reached cap pauses (never fails) AI work until the next day.
# Days are counted in this IANA timezone; unset = the default timezone above.
# STRATA_BUDGETS__TIMEZONE=Africa/Cairo
# STRATA_BUDGETS__PER_USER_DAILY_TOKENS=2000000
# STRATA_BUDGETS__PER_USER_DAILY_COST_MICROS=0
# STRATA_BUDGETS__GLOBAL_DAILY_TOKENS=4000000
# STRATA_BUDGETS__GLOBAL_DAILY_COST_MICROS=0

# ── Accounts ───────────────────────────────────────────────────────────────────────────────
# Days between scheduling a deletion and the purge (D25).
# STRATA_ACCOUNTS__DELETION_GRACE_DAYS=14
# Accounts allowed to wait for approval at once (§15).
# STRATA_ACCOUNTS__MAX_PENDING_SIGNUPS=20
# How often the purge job runs, seconds.
# STRATA_ACCOUNTS__PURGE_INTERVAL_SECS=300

# ── Push (D27 later step; files are mode 0600 and never logged) ────────────────────────────
# STRATA_PUSH__FCM_SERVICE_ACCOUNT_PATH=/etc/strata/fcm.json
# STRATA_PUSH__APNS_KEY_PATH=/etc/strata/apns.p8
# STRATA_PUSH__APNS_KEY_ID=ABC123DEFG
# STRATA_PUSH__APNS_TEAM_ID=TEAM123456
# STRATA_PUSH__APNS_TOPIC=com.shawket.strata
# STRATA_PUSH__WNS_CREDENTIALS_PATH=/etc/strata/wns.json

# ── Authentication (PLAN §8, D6) ───────────────────────────────────────────────────────────
# Ed25519 PKCS#8 PEM key for access tokens (stratad keygen; mode 0600).
STRATA_AUTH__SIGNING_KEY_FILE=/etc/strata/token-signing-key.pem
# STRATA_AUTH__ISSUER=strata
# STRATA_AUTH__AUDIENCE=strata-api
# Access-token lifetime, seconds (PLAN §8: 15 minutes).
# STRATA_AUTH__ACCESS_TOKEN_TTL_SECS=900
# Absolute lifetime of a device session, days.
# STRATA_AUTH__SESSION_TTL_DAYS=90
# Revocation-set reload period, seconds.
# STRATA_AUTH__REVOCATION_RELOAD_SECS=30
# Take the client IP from X-Forwarded-For (only when nginx is the sole client).
# STRATA_AUTH__TRUST_FORWARDED_FOR=false
# STRATA_AUTH__MIN_PASSWORD_LENGTH=10
# Argon2id cost for new hashes (OWASP: 19 MiB, 2 passes, 1 lane).
# STRATA_AUTH__ARGON2__MEMORY_KIB=19456
# STRATA_AUTH__ARGON2__ITERATIONS=2
# STRATA_AUTH__ARGON2__PARALLELISM=1
# Sliding-window rate limits: at most MAX events per WINDOW_SECS. Per client IP / username:
# STRATA_AUTH__RATE_LIMITS__LOGIN_PER_IP__MAX=30
# STRATA_AUTH__RATE_LIMITS__LOGIN_PER_IP__WINDOW_SECS=900
# STRATA_AUTH__RATE_LIMITS__LOGIN_PER_USERNAME__MAX=10
# STRATA_AUTH__RATE_LIMITS__LOGIN_PER_USERNAME__WINDOW_SECS=900
# STRATA_AUTH__RATE_LIMITS__SIGNUP_PER_IP__MAX=5
# STRATA_AUTH__RATE_LIMITS__SIGNUP_PER_IP__WINDOW_SECS=3600
# STRATA_AUTH__RATE_LIMITS__SIGNUP_GLOBAL__MAX=30
# STRATA_AUTH__RATE_LIMITS__SIGNUP_GLOBAL__WINDOW_SECS=3600
# Per user (PLAN §8): POST /capture and POST /ask.
# STRATA_AUTH__RATE_LIMITS__CAPTURE_PER_USER__MAX=60
# STRATA_AUTH__RATE_LIMITS__CAPTURE_PER_USER__WINDOW_SECS=60
# STRATA_AUTH__RATE_LIMITS__ASK_PER_USER__MAX=20
# STRATA_AUTH__RATE_LIMITS__ASK_PER_USER__WINDOW_SECS=60

# ── Background jobs (PLAN §5.2, §9.2) ──────────────────────────────────────────────────────
# Fair round-robin across users. Jobs running at once across all users (1 CPU core);
# embeddings also run one at a time, LLM calls at most the claude -p concurrency above.
# STRATA_JOBS__MAX_CONCURRENCY=2
# Seconds between scheduling passes when nothing is runnable.
# STRATA_JOBS__POLL_INTERVAL_SECS=5
# Seconds a user whose queued jobs are all of kinds this build does not run is skipped.
# STRATA_JOBS__IDLE_RECHECK_SECS=60
# Retry delays: the first retry after BACKOFF_BASE_SECS, doubling per attempt, at most
# BACKOFF_MAX_SECS.
# STRATA_JOBS__BACKOFF_BASE_SECS=30
# STRATA_JOBS__BACKOFF_MAX_SECS=3600
# Local hour (0–23, in the default timezone) of the nightly jobs (semantic duplicate sweep,
# entity insights sweep, clustering) and of the weekly digest.
# STRATA_JOBS__NIGHTLY_HOUR=3
# Day of the weekly AI digest (_ai/digests/YYYY-Www.md): mon, tue, wed, thu, fri, sat or sun.
# STRATA_JOBS__DIGEST_WEEKDAY=mon
# Seconds a graceful shutdown waits for running jobs (unfinished ones are re-queued at start).
# STRATA_JOBS__SHUTDOWN_GRACE_SECS=30
