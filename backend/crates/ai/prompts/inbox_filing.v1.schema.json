{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "inbox_filing.v1 output",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^*\"\\\\/<>:|?#^\\[\\]]+$"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[^\\s#]+$"
      },
      "maxItems": 5
    },
    "destination_folder": {
      "type": "string",
      "minLength": 1
    },
    "lang": {
      "type": "string",
      "enum": [
        "ar",
        "en",
        "mixed"
      ]
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "related",
              "part-of",
              "supports",
              "contradicts",
              "follows-up",
              "duplicates"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "target_id",
          "type",
          "confidence",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "existing_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "name",
          "existing_id",
          "confidence"
        ],
        "additionalProperties": false
      }
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "existing_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "is_nickname": {
            "type": "boolean"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "name",
          "existing_id",
          "is_nickname",
          "confidence"
        ],
        "additionalProperties": false
      }
    },
    "companies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "existing_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "name",
          "existing_id",
          "confidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "title",
    "tags",
    "destination_folder",
    "lang",
    "relations",
    "concepts",
    "people",
    "companies"
  ],
  "additionalProperties": false
}
