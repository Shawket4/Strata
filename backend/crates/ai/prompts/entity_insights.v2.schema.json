{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "entity_insights.v2 output",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "insights": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "note_id": {
                  "type": "string",
                  "minLength": 1
                },
                "block_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "note_id",
                "block_id"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "text",
          "citations"
        ],
        "additionalProperties": false
      }
    },
    "open_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "note_id": {
                  "type": "string",
                  "minLength": 1
                },
                "block_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "note_id",
                "block_id"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "text",
          "citations"
        ],
        "additionalProperties": false
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "note_id": {
                  "type": "string",
                  "minLength": 1
                },
                "block_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "note_id",
                "block_id"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "date",
          "text",
          "citations"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "summary",
    "insights",
    "open_items",
    "timeline"
  ],
  "additionalProperties": false
}
