{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "custody.v1 output",
  "type": "object",
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "stored-at",
              "moved-to",
              "handed-to",
              "returned-by",
              "sent-to",
              "received-from",
              "lost",
              "found",
              "destroyed"
            ]
          },
          "document": {
            "type": "string",
            "minLength": 1
          },
          "document_existing_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "place": {
            "type": [
              "string",
              "null"
            ]
          },
          "place_existing_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "place_part_of": {
            "type": [
              "string",
              "null"
            ]
          },
          "person": {
            "type": [
              "string",
              "null"
            ]
          },
          "person_existing_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "counterparty": {
            "type": [
              "string",
              "null"
            ]
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "date_source": {
            "type": "string",
            "enum": [
              "explicit",
              "relative",
              "created"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_block_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "type",
          "document",
          "document_existing_id",
          "place",
          "place_existing_id",
          "place_part_of",
          "person",
          "person_existing_id",
          "counterparty",
          "date",
          "date_source",
          "confidence",
          "evidence_block_id",
          "quote"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "events"
  ],
  "additionalProperties": false
}
