{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "inbox_filing.v2 output",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^*\"\\\\/<>:|?#^\\[\\]]+$"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[^\\s#]+$"
      },
      "maxItems": 5
    },
    "destination_folder": {
      "type": "string",
      "minLength": 1
    },
    "lang": {
      "type": "string",
      "enum": [
        "ar",
        "en",
        "mixed"
      ]
    },
    "is_correction": {
      "type": "boolean"
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "related",
              "part-of",
              "supports",
              "contradicts",
              "follows-up",
              "duplicates"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "target_id",
          "type",
          "confidence",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "existing_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "existing_id",
          "confidence",
          "summary"
        ],
        "additionalProperties": false
      }
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "existing_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "candidate_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "is_nickname": {
            "type": "boolean"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_block_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "existing_id",
          "candidate_ids",
          "is_nickname",
          "confidence",
          "evidence_block_id"
        ],
        "additionalProperties": false
      }
    },
    "companies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "existing_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "candidate_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "is_nickname": {
            "type": "boolean"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_block_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "existing_id",
          "candidate_ids",
          "is_nickname",
          "confidence",
          "evidence_block_id"
        ],
        "additionalProperties": false
      }
    },
    "custody": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "stored-at",
              "moved-to",
              "handed-to",
              "returned-by",
              "sent-to",
              "received-from",
              "lost",
              "found",
              "destroyed"
            ]
          },
          "document": {
            "type": "string",
            "minLength": 1
          },
          "document_existing_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "place": {
            "type": [
              "string",
              "null"
            ]
          },
          "place_existing_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "place_part_of": {
            "type": [
              "string",
              "null"
            ]
          },
          "person": {
            "type": [
              "string",
              "null"
            ]
          },
          "person_existing_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "counterparty": {
            "type": [
              "string",
              "null"
            ]
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "date_source": {
            "type": "string",
            "enum": [
              "explicit",
              "relative",
              "created"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_block_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "type",
          "document",
          "document_existing_id",
          "place",
          "place_existing_id",
          "place_part_of",
          "person",
          "person_existing_id",
          "counterparty",
          "date",
          "date_source",
          "confidence",
          "evidence_block_id",
          "quote"
        ],
        "additionalProperties": false
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "due": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "date_source": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "explicit",
              "relative",
              "created",
              null
            ]
          },
          "recurrence": {
            "type": [
              "string",
              "null"
            ]
          },
          "reminders": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}$"
            }
          },
          "entities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_block_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "title",
          "due",
          "date_source",
          "recurrence",
          "reminders",
          "entities",
          "confidence",
          "evidence_block_id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "title",
    "tags",
    "destination_folder",
    "lang",
    "is_correction",
    "relations",
    "concepts",
    "people",
    "companies",
    "custody",
    "tasks"
  ],
  "additionalProperties": false
}
