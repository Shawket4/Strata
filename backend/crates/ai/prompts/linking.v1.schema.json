{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "linking.v1 output",
  "type": "object",
  "properties": {
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "related",
              "part-of",
              "supports",
              "contradicts",
              "follows-up",
              "duplicates"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "target_id",
          "type",
          "confidence",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "existing_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "name",
          "existing_id",
          "confidence"
        ],
        "additionalProperties": false
      }
    },
    "mentions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "person",
              "company",
              "document",
              "place"
            ]
          },
          "existing_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "candidate_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "is_nickname": {
            "type": "boolean"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_block_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "text",
          "kind",
          "existing_id",
          "candidate_ids",
          "is_nickname",
          "confidence",
          "evidence_block_id"
        ],
        "additionalProperties": false
      }
    },
    "entity_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "works-at",
              "worked-at",
              "reports-to",
              "knows",
              "introduced-by",
              "client-of",
              "supplier-of",
              "partner-of",
              "competitor-of",
              "subsidiary-of"
            ]
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_block_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "from",
          "type",
          "to",
          "confidence",
          "reason",
          "evidence_block_id"
        ],
        "additionalProperties": false
      }
    },
    "custody": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "stored-at",
              "moved-to",
              "handed-to",
              "returned-by",
              "sent-to",
              "received-from",
              "lost",
              "found",
              "destroyed"
            ]
          },
          "document": {
            "type": "string",
            "minLength": 1
          },
          "document_existing_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "place": {
            "type": [
              "string",
              "null"
            ]
          },
          "place_existing_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "place_part_of": {
            "type": [
              "string",
              "null"
            ]
          },
          "person": {
            "type": [
              "string",
              "null"
            ]
          },
          "person_existing_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "counterparty": {
            "type": [
              "string",
              "null"
            ]
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "date_source": {
            "type": "string",
            "enum": [
              "explicit",
              "relative",
              "created"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_block_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "type",
          "document",
          "document_existing_id",
          "place",
          "place_existing_id",
          "place_part_of",
          "person",
          "person_existing_id",
          "counterparty",
          "date",
          "date_source",
          "confidence",
          "evidence_block_id",
          "quote"
        ],
        "additionalProperties": false
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "due": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "date_source": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "explicit",
              "relative",
              "created",
              null
            ]
          },
          "recurrence": {
            "type": [
              "string",
              "null"
            ]
          },
          "reminders": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}$"
            }
          },
          "entities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_block_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "title",
          "due",
          "date_source",
          "recurrence",
          "reminders",
          "entities",
          "confidence",
          "evidence_block_id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "relations",
    "concepts",
    "mentions",
    "entity_relations",
    "custody",
    "tasks"
  ],
  "additionalProperties": false
}
