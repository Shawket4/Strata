{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cluster_naming.v1 output",
  "type": "object",
  "properties": {
    "names": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cluster_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "required": [
          "cluster_id",
          "name"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "names"
  ],
  "additionalProperties": false
}
